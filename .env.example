# Database configuration for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=mini_relis
POSTGRES_PORT=5432

# Connection string for Prisma
DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/mini_relis?schema=public"

# API Server port
PORT=3000

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
